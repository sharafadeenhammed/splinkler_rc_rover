[Unit]
Description=Sprinkler Rover dashboard (Rover OS)
After=network-online.target pigpiod.service
Wants=network-online.target pigpiod.service
# pigpiod must be running: motors, encoders and the ultrasonic sensor all
# talk to the pigpio daemon.  Wants= pulls it in at boot (After= only orders),
# so enabling rover.service is enough even on a fresh image.

[Service]
Type=simple
User=rover_dev
WorkingDirectory=/home/rover_dev/project
# glibc spawns a 64 MB malloc arena per ~8 threads by default; with 16+
# threads on a 512 MB board the freed/fragmented arenas keep RSS tens of MB
# higher than it needs to be.  Two arenas is the standard Raspberry Pi fix.
Environment=MALLOC_ARENA_MAX=2
#ExecStart=/home/rover_dev/project/.venv/bin/gunicorn --config deploy/gunicorn.conf.py main:app
ExecStart=/home/rover_dev/project/.venv/bin/python /home/rover_dev/project/main.py
# Optional command PIN: set ROVER_PIN on the Pi's copy of this unit (don't
# commit real values).  When set, the four control endpoints, their WS
# equivalents and starting a sweep demand it; stopping never does.
# Environment=ROVER_PIN=123456
# Set to 0 only if the moisture module reports wet on GPIO HIGH/released.
# Environment=SOIL_SENSOR_WET_WHEN_PRESSED=0
Restart=on-failure
RestartSec=9

# --- Memory backstop (512 MB Pi Zero W) ------------------------------------
# Cap this service so it can never consume the memory the Wi-Fi firmware
# needs.  Under pressure the kernel reclaims first, then kills THIS service
# (which restarts in 3 s) instead of letting brcmfmac fail to allocate and
# killing Wi-Fi until a power cycle.  220M ≈ 1.5x the measured peak: app
# 48 MB idle / 68 MB streaming, ~144 MB whole-system peak incl. camera
# buffers (measured 2026-10-28); the watchdog sheds the camera far below
# this line, so the cap only ever fires on a genuine leak.
#MemoryMax=220M

# Make this service the OOM killer's first choice, ahead of wpa_supplicant /
# brcmfmac (those have oom_score_adjust = 0 by default).
#OOMScoreAdjust=200

# pigpiod keeps GPIO PWM running after this process dies, so an OOM kill
# (SIGKILL — no atexit/signal handler can run) would otherwise leave the
# rover driving.  This backstop zeroes motor PWM + pump on every stop.
ExecStopPost=/home/rover_dev/project/.venv/bin/python /home/rover_dev/project/deploy/emergency_stop.py

[Install]
WantedBy=multi-user.target
